.venv/
.git/
**/__pycache__/
**/*.pyc
db.sqlite3
.claude/
.superpowers/
docs/
bin/

# Never bake env files (secrets) into the image — prod env reaches the
# container via compose's `env_file:`, not the image filesystem.
.env
.env.*

# Same reason: garage.prod.toml is generated at prod.sh runtime and holds the
# real GARAGE_RPC_SECRET — it must never enter the build context either.
podman/*.prod.toml

# Local data that never belongs in the image
backup/
migrasi/
media/

# The HTTPS key and the certificate authority's key: mounted into nginx, never in the image.
podman/tls/
