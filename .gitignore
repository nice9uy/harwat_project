# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Local dev database
db.sqlite3

# User-uploaded files (dev; prod serves from a mounted volume)
/media/

# Collected static files (collectstatic output in prod, a dev.sh symlink in
# dev) — no trailing slash: a symlink isn't a directory, so `staticfiles/`
# alone wouldn't match it
staticfiles

# Claude Code worktree state (never commit another session's checkout)
.claude/worktrees/
graphify-out/

# Tailwind standalone CLI (platform-specific binary, not committed)
bin/
.kilo/

# Podman infra secrets (generated/copied locally, never committed)
.env.dev
.env.prod
podman/garage.prod.toml

# Backups made from the Backup menu (settings.BACKUP_DIR)
/backup/

# Photos copied out of the old prod containers by prod.sh, on their way to Garage
/migrasi/

# The HTTPS certificate, its key and the local certificate authority
# (scripts/siapkan-tls.sh); generated per machine, never committed
/podman/tls/
