# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Local dev database
db.sqlite3

# Collected static files (collectstatic output)
staticfiles/

# Claude Code worktree state (never commit another session's checkout)
.claude/worktrees/
graphify-out/

# Tailwind standalone CLI (platform-specific binary, not committed)
bin/

# Podman infra secrets (generated/copied locally, never committed)
.env.dev
.env.prod
podman/garage.prod.toml
